{
  "mcpServers": {
    "invisible-playwright": {
      "command": "bash",
      "args": ["scripts/invisible-playwright-mcp.sh"],
      "env": {
        "IP_HEADLESS": "true",
        "IP_LOCALE": "de-DE",
        "IP_TIMEZONE": "Europe/Berlin",
        "IP_STORAGE_STATE": "tmp/browser-state.json"
      }
    }
  }
}
