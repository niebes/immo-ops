node_modules/
*.log
.DS_Store
.idea/

# User layer — personal data, never committed
config/profile.yml
config/cookies-*.json
modes/_profile.md
portals.yml

# Generated content — all user-specific
/applications/
data/listings.md
data/pipeline.md
data/scan-history.tsv
data/scan-failures.json
data/viewings.md
data/documents.md
# Backups/snapshots carry the same personal data as the files above
data/*.bak*
data/*.prerescan
*.bak
reports/
research/
correspondence/
!correspondence/README.md
output/
batch/tracker-additions/
batch/logs/

# Temporary verification / working files
tmp/
inbox/

# Personal documents (SCHUFA, IDs, payslips, …) — contents never committed,
# but keep the folder in the public repo via the placeholder.
/documents/*
!/documents/.gitkeep

# Claude Code local settings
.claude/settings.local.json

# Python bytecode from the vendored invisible-playwright scripts
__pycache__/
*.pyc
