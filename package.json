{
  "name": "immo-ops",
  "version": "0.1.0",
  "description": "AI real estate search command center — evaluate listings, score neighborhoods, scan portals, track applications",
  "type": "module",
  "scripts": {
    "test": "node --test \"scripts/test/*.test.mjs\"",
    "verify": "node scripts/verify-pipeline.mjs",
    "merge": "node scripts/merge-tracker.mjs",
    "score": "node scripts/score-listing.mjs",
    "dedup": "node scripts/dedup-listings.mjs",
    "dedup:fix": "node scripts/dedup-listings.mjs --fix",
    "expiry": "node scripts/listing-expiry-check.mjs",
    "scan": "node scripts/scan.mjs",
    "scan:dry": "node scripts/scan.mjs --dry-run",
    "scan:headed": "node scripts/scan.mjs --headed",
    "scan:invisible": "node scripts/scan.mjs --invisible",
    "scan:debug-chrome": "node scripts/scan.mjs --debug-chrome",
    "scan:cic": "node scripts/scan.mjs --debug-chrome",
    "chrome:immo": "scripts/immo-chrome.sh",
    "login:immoscout": "node scripts/login-immoscout.mjs",
    "login:invisible": "bash scripts/invisible-venv.sh scripts/invisible-login.py",
    "process-scan": "node scripts/process-scan.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "playwright": "^1.60.0"
  },
  "private": true
}
